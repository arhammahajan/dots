<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Obsidian Slate</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#d8dadd</string>
        <key>caret</key>
        <string>#d8dadd</string>
        <key>selection</key>
        <string>#26313d</string>
        <key>lineHighlight</key>
        <string>#1d222b</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#61768f</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Keyword &amp; Storage</string>
      <key>scope</key>
      <string>keyword, storage, storage.type, storage.modifier</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b7d4ed</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Function &amp; Method</string>
      <key>scope</key>
      <string>entity.name.function, meta.function-call, support.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#d8dadd</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Type &amp; Class</string>
      <key>scope</key>
      <string>entity.name.type, entity.name.class, entity.name.struct, support.type, support.class</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b7d4ed</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, constant.other.symbol</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b2bcc4</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Constant &amp; Number</string>
      <key>scope</key>
      <string>constant.numeric, constant.language, constant.character</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#949ea3</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Variable &amp; Property</string>
      <key>scope</key>
      <string>variable, entity.name.tag, meta.object-literal.key, support.type.property-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#d8dadd</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Operator &amp; Punctuation</string>
      <key>scope</key>
      <string>keyword.operator, punctuation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#758a9b</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Markdown Heading</string>
      <key>scope</key>
      <string>markup.heading, entity.name.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b7d4ed</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Diff Inserted</string>
      <key>scope</key>
      <string>markup.inserted</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#b7d4ed</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Diff Deleted &amp; Invalid</string>
      <key>scope</key>
      <string>markup.deleted, invalid</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#e06c75</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
