#!/usr/bin/env bash
# zj — a Herdr-shaped control surface for Zellij.
#
# Herdr's model maps onto Zellij like this:
#
#   Herdr workspace  ->  Zellij session   (one per project, persistent)
#   Herdr tab        ->  Zellij tab       (one per agent or task)
#   Herdr pane       ->  Zellij pane
#   Herdr agent list ->  Zellij Inbox     (OSC 7501 attention, cross-session)
#
# Everything the agents report travels over OSC 7501, which Zellij 0.46 parses
# natively. `zj status` emits the protocol for agents and scripts that do not
# speak it themselves; `zj agent` wraps the launched agent in a tiny OSC 7501
# reporter and gives it a tab.
set -euo pipefail

ZELLIJ_BIN="${ZELLIJ_BIN:-zellij}"
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname -- "$SELF")" && pwd -P)"
RESUME_HELPER="$SELF_DIR/zj-resume.py"

die() { printf 'zj: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
zj — agent workspace control for Zellij (Herdr-style)

Usage:
  zj                     Attach to (or create) this project's session
  zj attach [NAME]       Attach to NAME (restoring it if exited); bare zj starts fresh
  zj new NAME            Create and attach to a named session
  zj ls [--names]        Show spaces with tabs, agent counts and cwd
  zj kill [NAME]         Kill a session (default: this project's)
  zj space list          Spaces table (same as zj ls)
  zj space current       Print the current space name
  zj space new NAME [DIR]
                         Create a space for DIR and switch to it
  zj space switch NAME   Switch to an existing or exited space
  zj space rename NAME   Rename the current space
  zj space close [NAME] [-y]
                         Close a space (asks unless -y / --yes)
  zj agent AGENT [ARGS]  Open AGENT in a new tab, reporting OSC 7501
  zj run [--] CMD...     Open CMD in a new pane (OSC 133/7501 aware)
  zj inbox               Open the Inbox (current or single running session)
  zj next                Jump to the next pane that needs attention
  zj status STATE [MSG] [KIND]
                         Emit an OSC 7501 record on this pane (inside Zellij)
  zj hook AGENT [Event]  Feed one harness hook event (observational)
  zj hooks [status|start|stop|restart]
                         Manage the local per-agent hook listener
  zj prompt TEXT         Type TEXT and Enter into the focused pane
  zj wait [STATE] [SECS] [PANE]
                         Wait for a pane to reach STATE (default: focused pane)
  zj read [--full]       Dump the focused pane (optionally with scrollback)
  zj panes               List panes with attention state (JSON)
  zj resume-command AGENT [DIR]
                         Show the resume invocation for the latest conversation
  zj doctor              Show installed config, sessions and target session

States: idle, working, done, blocked, error, clear
Kinds (blocked only): permission, question, auth

Closing the last pane of a space switches to another running space instead of
leaving Zellij. Detach (Ctrl-b q) keeps the space running as before.

Environment:
  ZJ_SESSION        Session name to use instead of the project directory name
  ZELLIJ_BIN        Zellij binary to use (default: zellij)
  ZJ_HANDOFF_DEBUG  Print the client's currently detected space socket
EOF
}

inside_zellij() { [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; }

project_root() {
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
        git rev-parse --show-toplevel
    else
        pwd -P
    fi
}

sanitize_name() {
    local name
    name="$(printf '%s' "$1" | tr -cs 'A-Za-z0-9_-' '-' | sed 's/^-*//; s/-*$//')"
    [[ -n "$name" ]] || name="agents"
    printf '%s' "${name:0:48}"
}

default_session() {
    if [[ -n "${ZJ_SESSION:-}" ]]; then
        sanitize_name "$ZJ_SESSION"
    else
        sanitize_name "$(basename "$(project_root)")"
    fi
}

running_sessions() {
    "$ZELLIJ_BIN" list-sessions -n 2>/dev/null |
        grep -v 'EXITED' |
        awk '{ print $1 }' |
        sed '/^[[:space:]]*$/d'
}

single_running_session() {
    local sessions count
    sessions="$(running_sessions)"
    count="$(printf '%s\n' "$sessions" | grep -c . || true)"
    [[ "$count" -eq 1 ]] || return 1
    printf '%s' "$sessions"
}

session_exists() {
    [[ -n "$1" ]] && running_sessions | grep -Fxq "$1"
}

# A space that has a saved layout and can be resurrected after the machine or
# its Zellij server went away.
resurrectable_session_exists() {
    [[ -n "$1" ]] || return 1
    "$ZELLIJ_BIN" list-sessions -n 2>/dev/null |
        grep -F "$1 [" | grep -q 'EXITED'
}

# A fresh name for a new space when the default name is held by an exited
# space. Exited spaces are restored only by an explicit choice (Spaces, or
# `zj attach NAME`), never because a plain `zj` happened to land on the name.
fresh_session_name() {
    local base="$1" candidate="$1" suffix=1
    while session_exists "$candidate" || resurrectable_session_exists "$candidate"; do
        suffix=$((suffix + 1))
        candidate="${base:0:44}-$suffix"
    done
    printf '%s' "$candidate"
}

# ---------------------------------------------------------------------------
# Space handoff
# ---------------------------------------------------------------------------
#
# Closing the last pane of a space ends its Zellij session and, by default,
# ends the attached client too. The Spaces plugin cannot change that: it runs
# inside the same session and dies with it. The `zj` client wrapper can, because
# it sits outside the session.
#
# While a client is attached the wrapper samples the server socket the client
# is connected to (via /proc and `ss`). That stays correct after in-Zellij
# session switches, where the client process survives but reconnects to a
# different session. When the client exits, a missing server socket means the
# space closed instead of detaching; if another space is still running the
# wrapper attaches to it, and only when none are left does Zellij close.
#
# Detach (Ctrl-b q) leaves the server socket alive, so it never triggers a
# handoff. Exited/resurrectable spaces are not attached automatically.

running_sessions_reverse() {
    "$ZELLIJ_BIN" list-sessions -n -r 2>/dev/null |
        grep -v 'EXITED' |
        awk '{ print $1 }' |
        sed '/^[[:space:]]*$/d'
}

# Print the socket inodes held by a client. Fails for a zombie or a process
# whose fds can no longer be read.
client_socket_inodes() {
    local pid="$1" listing
    [[ -d "/proc/$pid/fd" ]] || return 1
    listing="$(ls -l "/proc/$pid/fd" 2>/dev/null)" || return 1
    [[ -n "$listing" ]] || return 1
    printf '%s\n' "$listing" |
        sed -n 's/.*socket:\[\([0-9]*\)\].*/\1/p'
}

# Print the server socket of the session a Zellij client is showing.
server_socket_for_inodes() {
    local inodes="$1"
    [[ -n "$inodes" ]] || return 1
    command -v ss >/dev/null 2>&1 || return 1

    ss -xp 2>/dev/null | awk -v inodes="$inodes" '
        BEGIN {
            count = split(inodes, list, "\n")
            for (i = 1; i <= count; i++) wanted[list[i]] = 1
            while ((getline line < "/proc/net/unix") > 0) {
                split(line, field, " ")
                if (field[7] ~ /^[0-9]+$/ &&
                    field[8] ~ /\/zellij[\/-]|\/contract_version_1\//) {
                    inode_to_path[field[7]] = field[8]
                }
            }
        }
        {
            split($0, field, " ")
            if (field[1] !~ /^u_/ || length(field) < 8) next
            local_inode = field[6]
            peer_inode = field[8]
            if ((local_inode in wanted) && (peer_inode in inode_to_path)) {
                print inode_to_path[peer_inode]
                exit
            }
            if ((peer_inode in wanted) && (local_inode in inode_to_path)) {
                print inode_to_path[local_inode]
                exit
            }
        }'
}

zellij_socket_alive() {
    local socket="$1"
    [[ -n "$socket" && -S "$socket" ]] || return 1
    ss -xl 2>/dev/null | grep -Fq -- "$socket"
}

# Prefer the space this client started in (the natural "go back" target), then
# the most recently created other running space. The closed space is already
# gone from the running-session list, so it needs no explicit exclusion.
handoff_target() {
    local first="$1" session
    if [[ -n "$first" ]] && session_exists "$first"; then
        printf '%s' "$first"
        return 0
    fi
    while IFS= read -r session; do
        [[ -n "$session" ]] || continue
        printf '%s' "$session"
        return 0
    done < <(running_sessions_reverse)
    return 1
}

# Run a Zellij client and, when its space closes while other spaces are still
# running, attach to the next space instead of leaving Zellij.
run_client_with_handoff() {
    local name="$1"
    shift
    local first="$name"
    local command=("$@")
    local status pid socket detected inodes known_inodes existed_before next attempts=0
    local can_inspect=0
    [[ -d /proc/self/fd ]] && can_inspect=1

    while :; do
        attempts=$((attempts + 1))
        socket=""
        known_inodes=""
        existed_before=0
        session_exists "$name" && existed_before=1

        # An explicit stdin redirect is required: a background job in a
        # non-interactive shell otherwise gets /dev/null and the client would
        # not receive keystrokes.
        "${command[@]}" <&0 &
        pid=$!
        sleep 0.2
        while kill -0 "$pid" 2>/dev/null; do
            if (( can_inspect )); then
                # Fails for a zombie or a disappeared process.
                inodes="$(client_socket_inodes "$pid")" || break
                # Only re-map when the client's socket set changes; session
                # switches reconnect the same process to a new server socket.
                if [[ -n "$inodes" &&
                    ( "$inodes" != "$known_inodes" || -z "$socket" ) ]]; then
                    detected="$(server_socket_for_inodes "$inodes")" || detected=""
                    if [[ -n "$detected" ]]; then
                        known_inodes="$inodes"
                        if [[ "$detected" != "$socket" ]]; then
                            socket="$detected"
                            [[ -n "${ZJ_HANDOFF_DEBUG:-}" ]] &&
                                printf 'zj: client %s is in %s\n' "$pid" "$socket" >&2
                        fi
                    fi
                fi
            fi
            sleep 0.4
        done
        status=0
        wait "$pid" || status=$?

        if [[ -n "$socket" ]]; then
            zellij_socket_alive "$socket" && return "$status"
        elif session_exists "$name"; then
            return "$status"
        elif (( ! existed_before )); then
            # The client never attached (bad layout, connection error, ...).
            # Do not cascade into an unrelated space.
            return "$status"
        fi

        (( attempts < 20 )) || return "$status"
        next="$(handoff_target "$first")" || return "$status"
        printf 'zj: space closed; switching to %s\n' "$next" >&2
        name="$next"
        command=("$ZELLIJ_BIN" attach "$name")
    done
}

# attach_with_handoff NAME [ATTACH OPTIONS...]
attach_with_handoff() {
    local name="$1"
    shift
    run_client_with_handoff "$name" "$ZELLIJ_BIN" attach "$@" "$name"
}

# The session a command should act on. Inside Zellij this is always the current
# session, even if it was started with bare `zellij` and has a generated name.
# Outside, prefer the only running session, then the project-named one.
current_session() {
    if inside_zellij; then
        printf '%s' "$ZELLIJ_SESSION_NAME"
        return 0
    fi
    local sessions count project
    sessions="$(running_sessions)"
    count="$(printf '%s\n' "$sessions" | grep -c . || true)"
    if [[ "$count" -eq 1 ]]; then
        printf '%s' "$sessions"
        return 0
    fi
    project="$(default_session)"
    if printf '%s\n' "$sessions" | grep -Fxq "$project"; then
        printf '%s' "$project"
        return 0
    fi
    return 1
}

session_has_client() {
    [[ -n "$("$ZELLIJ_BIN" --session "$1" action list-clients 2>/dev/null |
        tail -n +2 | tr -d '[:space:]')" ]]
}

# Run an action in the current session, or in the single/current session when
# invoked from outside Zellij.
action_cmd() {
    if inside_zellij; then
        "$ZELLIJ_BIN" action "$@"
    else
        local session
        session="$(current_session)" ||
            die "no unambiguous running session; use 'zj ls' and 'zj attach NAME'"
        "$ZELLIJ_BIN" --session "$session" action "$@"
    fi
}

require_visible_session() {
    inside_zellij && return 0
    local session
    session="$(current_session)" ||
        die "no unambiguous running session; use 'zj ls' and 'zj attach NAME'"
    session_has_client "$session" ||
        die "session '$session' has no attached client; run 'zj attach $session' first"
}

space_focus() {
    # Zellij's CLI cannot switch an attached client between sessions (session
    # switching is a client-side action), so launch the Spaces opener with a
    # target. The plugin waits for the session list, switches the client and
    # closes itself. It is a real popup, so it does not appear in list-panes;
    # wait for the target session to receive the client instead.
    local name="$1"
    if ! session_exists "$name" && resurrectable_session_exists "$name"; then
        "$SELF" __prepare-restore "$name" >/dev/null
    fi
    action_cmd launch-or-focus-plugin spaces --floating \
        --configuration "target=$name" >/dev/null
    for _ in $(seq 1 50); do
        if "$ZELLIJ_BIN" --session "$name" action list-clients 2>/dev/null |
            awk 'NR > 1 && NF { found = 1 } END { exit !found }'; then
            return 0
        fi
        sleep 0.1
    done
    die "could not switch to space '$name'"
}

space_table() {
    local session json tabs needs working done cwd marker current
    current="$(current_session 2>/dev/null || true)"
    printf '  %-22s %5s %6s %6s %5s  %s\n' SPACE TABS NEEDS WORK DONE CWD
    while IFS= read -r session; do
        [[ -n "$session" ]] || continue
        json="$("$ZELLIJ_BIN" --session "$session" action list-panes --json --all 2>/dev/null)" ||
            continue
        tabs="$("$ZELLIJ_BIN" --session "$session" action list-tabs --json 2>/dev/null |
            jq 'length' 2>/dev/null || echo 0)"
        needs="$(jq '[.[] | select(.attention.status == "NeedsYou")] | length' <<<"$json")"
        working="$(jq '[.[] | select(.attention.status == "Working")] | length' <<<"$json")"
        done="$(jq '[.[] | select(.attention.status == "Done")] | length' <<<"$json")"
        cwd="$(jq -r '[.[] | select(.is_focused)][0].command_state.cwd.path // empty' <<<"$json")"
        marker=" "
        [[ "$session" == "$current" ]] && marker="*"
        printf '%s %-22s %5s %6s %6s %5s  %s\n' \
            "$marker" "$session" "$tabs" "$needs" "$working" "$done" "$cwd"
    done < <(running_sessions)
}

canonical_app() {
    case "$1" in
        claude) printf 'claude-code' ;;
        kimi-cli) printf 'kimi' ;;
        dsh|dsh-tui) printf 'deepseek' ;;
        cursor) printf 'cursor-agent' ;;
        agy) printf 'antigravity' ;;
        *) printf '%s' "$1" ;;
    esac
}

emit_osc7501() {
    local state="$1" msg="${2:-}" kind="${3:-}" app="${ZJ_APP:-zj}"
    local body="state=$state:app=$app"
    if [[ -n "$kind" ]]; then
        body+=":kind=$kind"
    fi
    if [[ -n "$msg" ]]; then
        local encoded
        encoded="$(printf '%s' "$msg" | base64 | tr -d '\n')"
        body+=":msg=$encoded"
    fi
    # /dev/tty is the pane's pty slave, so this reaches Zellij even when the
    # caller's stdout is redirected. Fall back to stdout outside a tty.
    if [[ -w /dev/tty ]]; then
        printf '\033]7501;%s\033\\' "$body" >/dev/tty
    else
        printf '\033]7501;%s\033\\' "$body"
    fi
}

cmd="${1:-attach}"
[[ $# -gt 0 ]] && shift || true

if [[ "$cmd" != "__layout" && "$cmd" != "__shim" && \
      "$cmd" != "__hook" && "$cmd" != "__resume-wrap" && \
      "$cmd" != "__prepare-restore" && "$cmd" != "resume-command" && \
      "$cmd" != "hook" && "$cmd" != "hooks" && "$cmd" != "hook-server" && \
      "$cmd" != "__space-hooks" && "$cmd" != "session-hook" ]] &&
    ! command -v "$ZELLIJ_BIN" >/dev/null 2>&1; then
    die "zellij not found on PATH (set ZELLIJ_BIN)"
fi

case "$cmd" in
    attach|"")
        if inside_zellij; then
            if [[ $# -ge 1 ]]; then
                name="$1"
                if session_exists "$name"; then
                    "$ZELLIJ_BIN" action switch-session "$name"
                elif resurrectable_session_exists "$name"; then
                    space_focus "$name"
                else
                    die "session '$name' is not running; detach (Ctrl b q) first"
                fi
            else
                printf 'zj: already inside session %s (Ctrl-b b opens the Inbox)\n' \
                    "$ZELLIJ_SESSION_NAME"
            fi
        else
            name="${1:-}"
            explicit=0
            [[ -n "$name" ]] && explicit=1
            if [[ -z "$name" ]]; then
                if name="$(single_running_session)"; then
                    :
                elif session_exists "$(default_session)"; then
                    name="$(default_session)"
                elif [[ -n "$(running_sessions)" ]]; then
                    printf 'zj: multiple sessions are running:\n' >&2
                    running_sessions | sed 's/^/  /' >&2
                    die "choose one with 'zj attach NAME'"
                else
                    base="$(default_session)"
                    if resurrectable_session_exists "$base"; then
                        name="$(fresh_session_name "$base")"
                        printf 'zj: space %s is exited; starting fresh space %s\n' \
                            "$base" "$name" >&2
                        printf 'zj: restore %s from Spaces when you want it back\n' \
                            "$base" >&2
                    else
                        name="$base"
                    fi
                fi
            fi
            if (( explicit )) && resurrectable_session_exists "$name"; then
                "$SELF" __prepare-restore "$name" >/dev/null
            fi
            attach_with_handoff "$name" --create --force-run-commands
        fi
        ;;
    new)
        [[ $# -ge 1 ]] || die "usage: zj new NAME"
        inside_zellij && die "already inside Zellij; detach (Ctrl b q) or use 'zj agent'"
        name="$(sanitize_name "$1")"
        if resurrectable_session_exists "$name"; then
            die "space '$name' is exited; restore it from Spaces or choose another name"
        fi
        attach_with_handoff "$name" --create
        ;;
    ls|list)
        if [[ "${1:-}" == "--names" ]]; then
            running_sessions
        else
            space_table
        fi
        ;;
    space|spaces)
        sub="${1:-list}"
        [[ $# -gt 0 ]] && shift || true
        case "$sub" in
            list|ls)
                space_table
                ;;
            current)
                current_session ||
                    die "not inside a Zellij space and no unambiguous session"
                printf '\n'
                ;;
            new)
                name="${1:-}"
                dir="${2:-$PWD}"
                [[ -d "$dir" ]] || die "not a directory: $dir"
                dir="$(cd "$dir" && pwd -P)"
                [[ -n "$name" ]] || name="$(basename "$dir")"
                name="$(sanitize_name "$name")"
                session_exists "$name" && die "space '$name' already exists"
                if resurrectable_session_exists "$name"; then
                    die "space '$name' is exited; restore it from Spaces or choose another name"
                fi
                if inside_zellij; then
                    ( cd "$dir" && "$ZELLIJ_BIN" attach --create-background "$name" ) >/dev/null
                    sleep 0.2
                    space_focus "$name"
                else
                    ( cd "$dir" && attach_with_handoff "$name" --create )
                fi
                ;;
            switch|open)
                [[ $# -ge 1 ]] || die "usage: zj space switch NAME"
                name="$1"
                if ! session_exists "$name" && ! resurrectable_session_exists "$name"; then
                    die "no running or exited space named '$name'"
                fi
                if inside_zellij; then
                    space_focus "$name"
                else
                    if resurrectable_session_exists "$name"; then
                        "$SELF" __prepare-restore "$name" >/dev/null
                    fi
                    attach_with_handoff "$name" --force-run-commands
                fi
                ;;
            rename)
                [[ $# -ge 1 ]] || die "usage: zj space rename NEW_NAME"
                action_cmd rename-session "$(sanitize_name "$1")"
                ;;
            close)
                name="${1:-}"
                assume_yes=false
                for arg in "$@"; do
                    [[ "$arg" == "-y" || "$arg" == "--yes" ]] && assume_yes=true
                done
                [[ "$name" == "-y" || "$name" == "--yes" || -z "$name" ]] &&
                    name="$(current_session || true)"
                [[ -n "$name" ]] ||
                    die "no unambiguous space; use 'zj space close NAME'"
                if [[ "$assume_yes" == false ]]; then
                    if [[ -t 0 ]]; then
                        read -r -p "Close space '$name'? [y/N] " answer
                        [[ "$answer" == [yY]* ]] || { printf 'cancelled\n'; exit 0; }
                    else
                        die "refusing to close '$name' without --yes"
                    fi
                fi
                "$ZELLIJ_BIN" delete-session --force "$name" >/dev/null 2>&1 || true
                session_exists "$name" && die "could not close space '$name'"
                printf 'zj: closed space %s\n' "$name"
                ;;
            *)
                die "usage: zj space [list|current|new|switch|rename|close]"
                ;;
        esac
        ;;
    kill)
        if [[ $# -ge 1 ]]; then
            name="$1"
        else
            name="$(current_session)" ||
                die "no unambiguous running session; use 'zj ls' and 'zj kill NAME'"
        fi
        "$ZELLIJ_BIN" delete-session --force "$name" >/dev/null 2>&1 || true
        if session_exists "$name"; then
            die "could not kill session '$name'"
        fi
        printf 'zj: killed and deleted %s\n' "$name"
        ;;
    agent)
        [[ $# -ge 1 ]] || die "usage: zj agent AGENT [ARGS]"
        agent="$1"; shift
        case "$agent" in
            cursor) bin="cursor-agent" ;;
            *)      bin="$agent" ;;
        esac
        command -v "$bin" >/dev/null 2>&1 || die "agent '$bin' not found on PATH"
        label="$(sanitize_name "$agent")"
        layout="$("$SELF" __layout "$label" "$PWD" "$agent" "$bin" "$@")"
        if inside_zellij; then
            "$ZELLIJ_BIN" action new-tab --layout "$layout" >/dev/null
        else
            session="$(current_session || default_session)"
            if session_exists "$session"; then
                # A session with no attached client has no viewport, and Zellij
                # refuses to apply a tab layout in that state. A short-lived
                # headless client gives it one; the tab survives its exit.
                helper_pid=""
                if ! session_has_client "$session"; then
                    "$ZELLIJ_BIN" terminal "$session" --headless \
                        --rows 40 --cols 120 --duration-secs 30 >/dev/null 2>&1 &
                    helper_pid=$!
                    for _ in $(seq 1 30); do
                        session_has_client "$session" && break
                        sleep 0.1
                    done
                fi
                "$ZELLIJ_BIN" --session "$session" action new-tab --layout "$layout" >/dev/null
                [[ -n "$helper_pid" ]] && kill "$helper_pid" 2>/dev/null || true
                attach_with_handoff "$session"
            else
                run_client_with_handoff "$session" "$ZELLIJ_BIN" \
                    --session "$session" --new-session-with-layout "$layout"
            fi
        fi
        ;;
    run)
        [[ "${1:-}" == "--" ]] && shift
        [[ $# -ge 1 ]] || die "usage: zj run [--] CMD..."
        require_visible_session
        action_cmd new-pane --cwd "$PWD" -- "$@" >/dev/null
        ;;
    inbox)
        require_visible_session
        # Toggle like the Ctrl-b b keybinding: close an open Inbox/session
        # manager, otherwise open one. This also avoids duplicate managers when
        # invoked outside Zellij.
        inbox_ids="$(action_cmd list-panes --json --all |
            jq -r '.[] | select(((.plugin_url // "") | test("session-manager")) or .title == "Session Manager") | .id')"
        if [[ -n "$inbox_ids" ]]; then
            while IFS= read -r inbox_id; do
                [[ -n "$inbox_id" ]] || continue
                action_cmd close-pane --pane-id "plugin_$inbox_id" >/dev/null
            done <<<"$inbox_ids"
        else
            action_cmd launch-or-focus-plugin session-manager \
                --floating --move-to-focused-tab >/dev/null
        fi
        ;;
    next)
        require_visible_session
        action_cmd go-to-next-attention
        ;;
    status)
        inside_zellij ||
            die "zj status must run inside a Zellij pane: OSC 7501 is written to that pane's tty"
        [[ $# -ge 1 ]] || die "usage: zj status STATE [MSG] [KIND]"
        case "$1" in
            idle|working|done|blocked|error|clear) ;;
            *) die "invalid state '$1' (idle, working, done, blocked, error, clear)" ;;
        esac
        emit_osc7501 "$1" "${2:-}" "${3:-}"
        ;;
    prompt)
        [[ $# -ge 1 ]] || die "usage: zj prompt TEXT"
        require_visible_session
        action_cmd write-chars "$*"
        action_cmd write 13
        ;;
    wait)
        want="${1:-needs_you}"
        timeout="${2:-600}"
        target="${3:-${ZJ_PANE:-}}"
        [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout must be a number of seconds"
        case "$want" in
            needs_you|needs-you|blocked) want="needs_you" ;;
            failed|error)                want="failed" ;;
            done|working|idle|quiet|new_output) ;;
            *) die "invalid state '$want'" ;;
        esac
        if [[ -z "$target" ]]; then
            # The client's focused pane, not every pane reporting focus.
            target="$(action_cmd list-clients 2>/dev/null |
                awk 'NR > 1 { print $2; exit }')"
        fi
        target_id="${target##*_}"
        [[ "$target_id" =~ ^[0-9]+$ ]] || target_id=0
        deadline=$((SECONDS + timeout))
        while ((SECONDS < deadline)); do
            active_tab="$(action_cmd list-tabs --json |
                jq -r '[.[] | select(.active)][0].tab_id // 0')"
            current="$(action_cmd list-panes --json --all |
                jq -r --argjson tab "$active_tab" --argjson pid "$target_id" --arg want "$want" '
                    (if $pid > 0 then
                        [.[] | select(.is_plugin == false and .id == $pid)][0]
                     else
                        [.[] | select(.is_focused and .tab_id == $tab)][-1]
                     end) as $pane
                    | ($pane.attention.status // "Idle") as $status
                    | ([$pane.program_status[]?.state] | map(select(. != null))) as $records
                    | if $want == "done" and
                         ($status == "Done" or ($records | index("Done"))) then "done"
                      elif $want == "failed" and
                         ($status == "Failed" or ($records | index("Error"))) then "failed"
                      elif $status == "NeedsYou" then "needs_you"
                      elif $status == "NewOutput" then "new_output"
                      elif $status == null then "idle"
                      else ($status | ascii_downcase) end')"
            if [[ "$current" == "$want" ]]; then
                printf '%s\n' "$current"
                exit 0
            fi
            sleep 0.5
        done
        printf 'zj: timed out waiting for %s (last: %s)\n' "$want" "${current:-unknown}" >&2
        exit 1
        ;;
    read)
        if [[ "${1:-}" == "--full" ]]; then
            action_cmd dump-screen --full
        else
            action_cmd dump-screen
        fi
        ;;
    panes)
        action_cmd list-panes --json --all
        ;;
    doctor)
        printf 'zellij:  %s\n' "$("$ZELLIJ_BIN" --version 2>&1)"
        "$ZELLIJ_BIN" setup --check 2>&1 |
            grep -E 'CONFIG DIR|CONFIG FILE|KEYBINDS DIR' | sed 's/^/config:  /'
        if inside_zellij; then
            printf 'inside:  yes (%s)\n' "$ZELLIJ_SESSION_NAME"
        else
            printf 'inside:  no\n'
        fi
        printf 'sessions:\n'
        running_sessions | sed 's/^/  /' || true
        if target="$(current_session 2>/dev/null)"; then
            printf 'target:  %s\n' "$target"
            if session_has_client "$target"; then
                printf 'client:  attached\n'
            else
                printf 'client:  detached (run: zj attach %s)\n' "$target"
            fi
        else
            printf 'target:  none (run: zj attach NAME)\n'
        fi
        printf 'leader:  Ctrl-b, fallback Ctrl-Space; inbox: Ctrl-b b\n'
        if command -v ss >/dev/null 2>&1 && [[ -d /proc/self/fd ]]; then
            printf 'handoff: enabled (closing a space switches to another)\n'
        else
            printf 'handoff: unavailable (needs Linux /proc and ss)\n'
        fi
        ;;
    __hook)
        # Internal: Zellij post_command_discovery_hook.  Wrap interactive
        # agent commands so a restored pane resumes the last conversation.
        exec python3 "$RESUME_HELPER" hook
        ;;
    session-hook)
        # Internal: legacy harness hook entry point.  Receives the harness
        # session id on stdin, records it as this pane's explicit resurrect
        # target, and emits the lifecycle status named by the second argument.
        exec python3 "$RESUME_HELPER" session-hook \
            "${1:?session-hook needs an agent}" "${2:-}"
        ;;
    hook)
        # Harness-facing hook entry point.  Reads the provider JSON on stdin,
        # normalizes it, emits OSC 7501 and posts the record to the listener.
        exec python3 "$RESUME_HELPER" hook "${1:?hook needs an agent}" "${2:-}"
        ;;
    hooks)
        # Manage the local per-agent hook listener.
        exec python3 "$RESUME_HELPER" hooks "$@"
        ;;
    hook-server)
        # Internal: listener process (lazy start and the optional unit).
        exec python3 "$RESUME_HELPER" hook-server "$@"
        ;;
    __space-hooks)
        # Internal: normalized per-pane hook summaries/details for the Spaces
        # navigator.
        exec python3 "$RESUME_HELPER" space-hooks "$@"
        ;;
    __space-agents)
        # Internal: live agent-app map for the Spaces navigator. Peer session
        # manifests omit program status, so the navigator asks for this.
        exec python3 "$RESUME_HELPER" space-agents
        ;;
    __space-snapshot)
        # Internal: app + viewport text for agent panes across all running
        # sessions, used by the navigator's screen-reader fallback.
        exec python3 "$RESUME_HELPER" space-snapshot
        ;;
    __resume-wrap)
        # Internal: run the original agent command with its resume switch.
        exec python3 "$RESUME_HELPER" wrap "${1:?__resume-wrap needs an encoded command}" "${2:-}"
        ;;
    __prepare-restore)
        # Internal: let a saved session run its commands immediately instead
        # of starting them suspended behind a "Waiting to run" banner.
        exec python3 "$RESUME_HELPER" prepare-restore "${1:?__prepare-restore needs a session name}"
        ;;
    resume-command)
        # Public diagnostic: show what would be run for the latest conversation.
        exec python3 "$RESUME_HELPER" resume-command "$@"
        ;;
    __layout)
        # Internal: write a one-tab agent layout and print its path.
        [[ $# -ge 4 ]] || die "__layout requires LABEL CWD APP BIN [ARGS...]"
        label="$1"; cwd="$2"; app="$3"; bin="$4"; shift 4
        runtime="${XDG_RUNTIME_DIR:-/tmp}/zj"
        mkdir -p "$runtime"
        layout_file="$(mktemp "$runtime/agent-XXXXXX.kdl")"
        kdl_quote() {
            local value="$1"
            value="${value//\\/\\\\}"
            value="${value//\"/\\\"}"
            value="${value//$'\n'/\\n}"
            value="${value//$'\t'/\\t}"
            printf '%s' "$value"
        }
        {
            printf 'layout {\n'
            printf '    tab name="%s" {\n' "$(kdl_quote "$label")"
            printf '        pane size=1 borderless=true {\n'
            printf '            plugin location="zellij:tab-bar"\n'
            printf '        }\n'
            printf '        pane cwd="%s" command="%s" {\n' \
                "$(kdl_quote "$cwd")" "$(kdl_quote "$SELF")"
            printf '            args "__shim" "%s" "%s"' \
                "$(kdl_quote "$app")" "$(kdl_quote "$bin")"
            for arg in "$@"; do
                printf ' "%s"' "$(kdl_quote "$arg")"
            done
            printf '\n        }\n'
            printf '        pane size=1 borderless=true {\n'
            printf '            plugin location="zellij:status-bar"\n'
            printf '        }\n'
            printf '    }\n'
            printf '}\n'
        } >"$layout_file"
        printf '%s\n' "$layout_file"
        ;;
    __shim)
        # Internal: zj agent AGENT CMD... wrapped in OSC 7501 working/done/error.
        hold=0
        if [[ "${1:-}" == "--hold" ]]; then
            hold=1
            shift
        fi
        [[ $# -ge 2 ]] || die "__shim requires APP CMD"
        app="$1"; shift
        ZJ_APP="$(canonical_app "$(sanitize_name "$app")")"
        # Start idle, not working: a launch or resume is not a turn. The short
        # working record only makes Zellij remember the pane so it stays
        # visible in the Inbox while idle.
        emit_osc7501 working
        emit_osc7501 idle
        cmd=("$@")
        if [[ "$ZJ_APP" == "opencode" ]]; then
            isolated=0
            for arg in "${cmd[@]}"; do
                case "$arg" in
                    --standalone|--server|--server=*) isolated=1 ;;
                esac
            done
            if (( ! isolated )); then
                cmd=("${cmd[0]}" "--standalone" "${cmd[@]:1}")
            fi
        fi
        set +e
        "${cmd[@]}"
        code=$?
        set -e
        if [[ $code -eq 0 ]]; then
            emit_osc7501 done "finished"
        else
            emit_osc7501 error "exited with status $code"
        fi
        if [[ $hold -eq 1 ]]; then
            exec "${SHELL:-/bin/sh}" -l
        fi
        exit "$code"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        die "unknown command '$cmd' (try 'zj help')"
        ;;
esac
