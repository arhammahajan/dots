{
  "schema_version": 1,
  "provider": "meta",
  "model": "deepseek-v4.1-flash",
  "model_reasoning_efforts": {
    "deepseek-v4.1-flash": "low",
    "gemini-4-argon": "medium",
    "gpt-6-luna": "high",
    "local-llama": "low",
    "muse-spark-1.3-contributor": "medium",
    "qwen3.6-35b-a3b-ud-q4_k_xl": "high"
  },
  "tui": {
    "foreign_context_notice_shown": true
  },
  "mcpServers": {
    "agent-browser": {
      "command": "${HOME}/.local/bin/agent-browser",
      "args": [
        "mcp",
        "--tools",
        "core,debug",
        "--config",
        "${HOME}/.local/share/helium-tools/agent-browser/config.json"
      ]
    }
  },
  "managed_hooks_env_vars": [
    "USERPROFILE"
  ],
  "endpoint_transport": {
    "base_url": "http://127.0.0.1:4000/v1",
    "auth": "bearer"
  }
}