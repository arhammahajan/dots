#!/bin/sh
# Launch coding agents with process-local model-router settings.
set -eu

usage() {
    cat <<'EOF'
Usage: harness <agent> [args...]
       harness profile <instance> [args...]
       harness profile --list
       harness profile --describe <instance> [args...]

Agents:
  claude       codex        grok          cline
  opencode     pi           qwen          copilot
  kimi         kimi-cli     mcode         muse
  antigravity  fx           deepseek      kilo
  vibe         vibe-acp     antigravity-acp  gemini

Aliases: agy = antigravity, dsh = deepseek, kimi-code = kimi
Codex and Grok use their model-router configurations.
All remaining arguments are passed unchanged to the agent.
For T3 binary overrides, set HARNESS_AGENT instead of passing an agent argument.
EOF
}

# T3 binary overrides cannot prepend an argument before probes and SDK commands.
if [ -n "${HARNESS_AGENT:-}" ]; then
    agent=$HARNESS_AGENT
else
    if [ "$#" -eq 0 ]; then
        usage >&2
        exit 2
    fi
    agent=$1
    shift
fi
# A child invoking harness explicitly must be able to choose a different agent.
unset HARNESS_AGENT

case "$agent" in
    -h|--help) usage; exit 0 ;;
    agy) agent=antigravity ;;
    dsh) agent=deepseek ;;
    kimi-code) agent=kimi ;;
    claude|codex|grok|cline|opencode|pi|qwen|copilot|kimi|kimi-cli|mcode|muse|antigravity|antigravity-acp|fx|deepseek|kilo|vibe|vibe-acp|gemini|profile) ;;
    *)
        printf 'harness: unknown agent: %s\n' "$agent" >&2
        usage >&2
        exit 2
        ;;
esac

if [ "$agent" = profile ]; then
    if [ "$#" -eq 0 ]; then usage >&2; exit 2; fi
    case "$1" in -h|--help) usage; exit 0 ;; esac
    if [ "${1:-}" = --list ]; then
        exec python3 - <<'PY'
import json
from pathlib import Path
providers = {"codex": {"driver": "codex", "enabled": True, "displayName": "Codex"},
             **json.loads((Path.home() / ".t3/userdata/settings.json").read_text())["providerInstances"]}
for key, provider in providers.items():
    if provider.get("enabled", True):
        print(f"{key}\t{provider.get('displayName') or key}")
PY
    fi
    describe=false
    if [ "${1:-}" = --describe ]; then
        describe=true
        shift
    fi
    profile=${1:?Choose an instance from harness profile --list}
    shift
    # Only named profiles depend on the T3 inventory; ordinary launches do not.
    python3 - "$profile" <<'PY'
import json, sys
from pathlib import Path
providers = {"codex": {"enabled": True},
             **json.loads((Path.home() / ".t3/userdata/settings.json").read_text())["providerInstances"]}
provider = providers.get(sys.argv[1])
if provider is None or not provider.get("enabled", True):
    sys.exit(f"harness: unknown or disabled profile: {sys.argv[1]}")
PY
    profile_value() {
        python3 - "$profile" "$1" <<'PY'
import json, sys
from pathlib import Path
provider = json.loads((Path.home() / ".t3/userdata/settings.json").read_text())["providerInstances"][sys.argv[1]]
key = sys.argv[2]
if key.startswith("CLINE_"):
    print(next((entry["value"] for entry in provider.get("environment", []) if entry["name"] == key), ""))
else:
    print(provider.get("config", {}).get(key, ""))
PY
    }
    PATH="$HOME/.local/share/fnm:$HOME/.local/share/fnm/aliases/default/bin:$HOME/.local/share/deepseek-harness/bin:$HOME/.local/share/pnpm/bin:$PATH"
    export PATH
    profile_state=$HOME/.config/ai/orca
    native_binary=
    case "$profile" in
        codex) native_binary=$HOME/.local/bin/codex ;;
        grok) native_binary=$HOME/.local/bin/grok ;;
        codex_router)
            agent=codex
            shadow_home=$(profile_value shadowHomePath)
            if [ -n "$shadow_home" ]; then export CODEX_HOME="$shadow_home"; fi
            ;;
        grok_router) agent=grok ;;
        claudeAgent) agent=claude ;;
        acpRegistry_qwen) agent=qwen ;;
        acpRegistry_copilot) agent=copilot ;;
        acpRegistry_kimi) agent=kimi ;;
        acpRegistry_kimi_legacy) agent=kimi-cli ;;
        acpRegistry_cline)
            agent=cline
            set -- --tui "$@"
            CLINE_PROVIDER=$(profile_value CLINE_PROVIDER)
            CLINE_MODEL=$(profile_value CLINE_MODEL)
            export CLINE_PROVIDER CLINE_MODEL
            ;;
        acpRegistry_kilo) agent=kilo ;;
        acpRegistry_mistral_vibe) agent=vibe ;;
        acpRegistry_gemini) agent=gemini ;;
        acpRegistry_antigravity_router) agent=antigravity ;;
        acpRegistry_mcode) native_binary=$HOME/.minimax-code/bin/mcode ;;
        acpRegistry_omp) native_binary=$HOME/.local/bin/omp ;;
        acpRegistry_dsh)
            agent=deepseek
            set -- --profile dsh-tui --patch "$profile_state/dsh-terminal.patch.yml" "$@"
            ;;
        antigravity|antigravity_mahajanarham)
            native_binary=$HOME/.local/libexec/antigravity/agy
            unset GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_GEMINI_BASE_URL
            set -- --settings "$profile_state/antigravity-native-settings.json" "$@"
            ;;
        muse|fx|opencode|pi) agent=$profile ;;
        *) printf 'harness: no terminal mapping for profile: %s\n' "$profile" >&2; exit 2 ;;
    esac
    harness_path=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$0")
    if [ "$describe" = true ]; then
        if [ -n "$native_binary" ]; then set -- "$native_binary" "$@"
        else set -- "$harness_path" "$agent" "$@"; fi
        exec python3 -c 'import shlex, sys; print(shlex.join(sys.argv[1:]))' "$@"
    fi
    case "$profile" in
        antigravity|antigravity_mahajanarham)
            account_request=$(python3 - "$profile" <<'PY'
import json, sys
from pathlib import Path
accounts = json.loads((Path.home() / ".config/ai/orca/antigravity-native-accounts.json").read_text())
print(json.dumps({"target": {"runtime": "host"}, "accountId": accounts[sys.argv[1]]}))
PY
)
            node "$(dirname "$harness_path")/orca/rpc.cjs" accounts.antigravitySelect "$account_request" >/dev/null
            ;;
    esac
    if [ -n "$native_binary" ]; then exec "$native_binary" "$@"; fi
fi

# GUI clients may not inherit .zshenv. Defaults also work without a config link.
router_env="${XDG_CONFIG_HOME:-$HOME/.config}/ai/model-router.env"
if [ -r "$router_env" ]; then
    . "$router_env"
fi
export MODEL_ROUTER_URL="${MODEL_ROUTER_URL:-http://127.0.0.1:4000}"
export MODEL_ROUTER_API_KEY="${MODEL_ROUTER_API_KEY:-unused}"

router_session() {
    python3 -c 'from uuid import uuid4; print("router-session-" + str(uuid4()))'
}

case "$agent" in
    claude)
        export ANTHROPIC_BASE_URL="$MODEL_ROUTER_URL"
        export ANTHROPIC_AUTH_TOKEN="$MODEL_ROUTER_API_KEY"
        exec claude "$@"
        ;;
    codex)
        # Keep overrides local: T3's shadow home shares config.toml.
        exec "$HOME/.local/bin/codex" \
            -c 'model_provider="model_router"' \
            -c 'model="deepseek-v4.1-flash"' \
            -c 'service_tier="default"' \
            -c 'model_providers.model_router.name="Model Router"' \
            -c "model_providers.model_router.base_url=\"${MODEL_ROUTER_URL%/}/v1\"" \
            -c 'model_providers.model_router.env_key="MODEL_ROUTER_API_KEY"' \
            -c 'model_providers.model_router.wire_api="responses"' \
            -c 'model_providers.model_router.requires_openai_auth=false' \
            -c 'model_providers.model_router.supports_websockets=false' \
            "$@"
        ;;
    grok)
        export GROK_HOME="$HOME/.grok-t3/model-router"
        export GROK_MODELS_BASE_URL="${MODEL_ROUTER_URL%/}/v1"
        export GROK_MODELS_LIST_URL="$GROK_MODELS_BASE_URL/models"
        export XAI_API_KEY="$MODEL_ROUTER_API_KEY"
        GROK_MODEL_ROUTER_SESSION=$(router_session)
        export GROK_MODEL_ROUTER_SESSION
        exec "$HOME/.local/bin/grok" "$@"
        ;;
    cline)
        # Resolve npm's executable through fnm, avoiding the PATH wrapper.
        node_bin=$(fnm exec --using=default which node)
        session=$(router_session)
        exec "$(dirname "$node_bin")/cline" --key "$session" "$@"
        ;;
    kimi-cli)
        export OPENAI_BASE_URL="${MODEL_ROUTER_URL%/}/v1"
        OPENAI_API_KEY=$(router_session)
        export OPENAI_API_KEY
        exec "$HOME/.local/share/kimi-cli/bin/kimi-cli" "$@"
        ;;
    kilo)
        exec "$HOME/.kilo/bin/kilo" "$@"
        ;;
    muse)
        # T3 strips inherited META_API_KEY; restore it after launch.
        export META_API_KEY="$MODEL_ROUTER_API_KEY"
        exec "$HOME/.local/bin/muse" "$@"
        ;;
    fx)
        FX_MODEL_ROUTER_SESSION=$(router_session)
        export FX_MODEL_ROUTER_SESSION
        exec "$HOME/.local/libexec/fx/fx-router" "$@"
        ;;
    deepseek)
        if ! command -v node >/dev/null 2>&1; then
            PATH="${XDG_DATA_HOME:-$HOME/.local/share}/fnm/aliases/default/bin:$PATH"
            export PATH
        fi
        if [ "$#" -eq 0 ]; then
            set -- web
        fi
        exec "$HOME/.local/share/deepseek-harness/bin/dsh" "$@"
        ;;
    vibe|vibe-acp)
        VIBE_ROUTER_SESSION=$(router_session)
        export VIBE_ROUTER_SESSION
        exec "$HOME/.local/share/uv/tools/mistral-vibe/bin/$agent" "$@"
        ;;
    gemini)
        export GOOGLE_GEMINI_BASE_URL="${MODEL_ROUTER_URL%/}"
        export GEMINI_MODEL_ROUTER=1
        GEMINI_API_KEY=$(router_session)
        export GEMINI_API_KEY
        # Use the maintained source checkout, with Node available to GUI clients.
        node_home="${XDG_DATA_HOME:-$HOME/.local/share}/fnm/aliases/default"
        if [ -x "$node_home/bin/node" ]; then
            PATH="$node_home/bin:$PATH"
            export PATH
        fi
        gemini_repo=${GEMINI_CLI_REPO:-$HOME/dev/gemini-cli}
        gemini_entry=$gemini_repo/packages/cli/dist/index.js
        if [ ! -f "$gemini_entry" ]; then
            printf 'harness: build Gemini CLI in %s first (npm ci && npm run build)\n' "$gemini_repo" >&2
            exit 1
        fi
        exec node "$gemini_entry" "$@"
        ;;
    antigravity)
        export GOOGLE_GEMINI_BASE_URL="${MODEL_ROUTER_URL%/}"
        GEMINI_API_KEY=$(router_session)
        export GEMINI_API_KEY
        # This CLI needs the configured custom default passed explicitly.
        use_default_model=true
        for arg in "$@"; do
            case "$arg" in --model|--model=*) use_default_model=false ;; esac
        done
        if [ "$use_default_model" = true ]; then
            default_model=$(python3 -c '
import json
from pathlib import Path
settings = json.loads((Path.home() / ".gemini/antigravity-cli/settings.json").read_text())
print(settings.get("model", "deepseek-v4.1-flash"))
')
            set -- --model "$default_model" "$@"
        fi
        exec "$HOME/.local/libexec/antigravity/agy" "$@"
        ;;
    antigravity-acp)
        export GEMINI_HOME="$HOME/.config/ai/antigravity-router-acp"
        export AGY_ACP_ENABLE_GATEWAY_AUTH=1
        export AGY_ACP_DEFAULT_MODEL=deepseek-v4.1-flash
        export AGY_LLM_GATEWAY_URL="${MODEL_ROUTER_URL%/}"
        AGY_LLM_GATEWAY_API_KEY=$(router_session)
        export AGY_LLM_GATEWAY_API_KEY
        AGY_LLM_GATEWAY_MODELS=$(python3 -c '
import json, os
from urllib.request import urlopen
with urlopen(os.environ["AGY_LLM_GATEWAY_URL"] + "/v1/models", timeout=10) as response:
    models = json.load(response)["data"]
models.sort(key=lambda model: model["id"] != "deepseek-v4.1-flash")
print(",".join(model["id"] for model in models))
')
        export AGY_LLM_GATEWAY_MODELS
        acp_install="$HOME/.t3/tools/antigravity-acp/linux-x64"
        release=$(python3 -c '
import json
from pathlib import Path
print(json.loads((Path.home() / ".t3/tools/antigravity-acp/linux-x64/active.json").read_text())["releaseId"])
')
        exec "$acp_install/versions/$release/agy_acp_server.par" "$@"
        ;;
    kimi|mcode|opencode|pi|qwen|copilot)
        # These agents already configure their providers in their own settings.
        exec "$agent" "$@"
        ;;
esac
