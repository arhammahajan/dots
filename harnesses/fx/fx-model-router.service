[Unit]
Description=fx compatibility for the local model-router
Requires=model-router.service
After=model-router.service
PartOf=model-router.service

[Service]
ExecStart=/usr/bin/python3 %h/dev/dots/harnesses/fx/router-proxy.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
