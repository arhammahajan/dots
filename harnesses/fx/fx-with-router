#!/usr/bin/env python3
"""Give each fx invocation its own router affinity ID."""
import os
from pathlib import Path
import sys
from uuid import uuid4

binary = Path.home() / ".local/libexec/fx/fx-router"
os.environ["FX_MODEL_ROUTER_SESSION"] = "router-session-" + str(uuid4())
os.execv(str(binary), [str(binary), *sys.argv[1:]])
