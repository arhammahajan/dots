#!/bin/sh
set -eu
. "${XDG_CONFIG_HOME:-$HOME/.config}/ai/model-router.env"
export OPENAI_BASE_URL="${MODEL_ROUTER_URL%/}/v1"
# The router's bearer-session compatibility maps this token to upstream affinity.
export OPENAI_API_KEY="router-session-$(python3 -c 'from uuid import uuid4; print(uuid4())')"
exec "$HOME/.local/share/kimi-cli/bin/kimi-cli" "$@"
