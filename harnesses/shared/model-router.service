[Unit]
Description=Central model-router for coding harnesses
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/dev/model-router
ExecStart=%h/dev/model-router/model-router-go --config %h/.config/model-router/router-go.toml
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
