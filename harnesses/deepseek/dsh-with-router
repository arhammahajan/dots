#!/bin/sh
# Load the same public router settings in terminals and desktop-launched clients.
set -eu

router_env="${XDG_CONFIG_HOME:-$HOME/.config}/ai/model-router.env"
if [ -r "$router_env" ]; then
    . "$router_env"
fi
export MODEL_ROUTER_URL="${MODEL_ROUTER_URL:-http://127.0.0.1:4000}"
export MODEL_ROUTER_API_KEY="${MODEL_ROUTER_API_KEY:-unused}"

# Desktop clients may start outside an interactive shell's fnm environment.
if ! command -v node >/dev/null 2>&1; then
    PATH="${XDG_DATA_HOME:-$HOME/.local/share}/fnm/aliases/default/bin:$PATH"
    export PATH
fi

# Prefer the Web UI when invoked without a profile or arguments.
if [ "$#" -eq 0 ]; then
    set -- web
fi
exec "$HOME/.local/share/deepseek-harness/bin/dsh" "$@"
