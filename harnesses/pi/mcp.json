        "--mcp"
      ],
      "exposure": "deferred",
      "description": "browser-use controls for the existing shared Helium browser.",
      "timeout": 120
    },
    "cua-driver": {
      "command": "/home/arhammahajan/.local/bin/cua-driver",
      "args": [
        "mcp"
      ],
      "exposure": "deferred",
