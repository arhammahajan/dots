{
  "mcpServers": {
    "agent-browser": {
      "command": "${HOME}/.local/bin/agent-browser",
      "args": [
        "mcp",
        "--tools",
        "core,debug",
        "--config",
        "${HOME}/.local/share/helium-tools/agent-browser/config.json"
      ],
      "exposure": "deferred",
      "description": "agent-browser controls for the existing shared Helium browser.",
      "timeout": 120
    }
  }
}
