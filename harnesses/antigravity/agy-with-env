#!/usr/bin/env python3
"""Run Antigravity through model-router with a private per-run session header."""
import http.client
import json
import os
from pathlib import Path
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit
from uuid import uuid4


def main():
    target = urlsplit(os.environ.get("MODEL_ROUTER_URL", "http://127.0.0.1:4000"))
    session = str(uuid4())
    hop = {"host", "connection", "content-length", "transfer-encoding", "keep-alive"}

    class Proxy(BaseHTTPRequestHandler):
        def log_message(self, *_):
            pass

        def forward(self):
            headers = {k: v for k, v in self.headers.items() if k.lower() not in hop}
            headers["x-session-id"] = session
            body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
            factory = http.client.HTTPSConnection if target.scheme == "https" else http.client.HTTPConnection
            conn = factory(target.hostname, target.port, timeout=600)
            try:
                conn.request(self.command, target.path.rstrip("/") + self.path, body, headers)
                response = conn.getresponse()
                self.send_response(response.status)
                for key, value in response.getheaders():
                    if key.lower() not in hop:
                        self.send_header(key, value)
                self.end_headers()
                while chunk := response.read1(65536):
                    self.wfile.write(chunk)
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                pass
            finally:
                conn.close()

        do_GET = forward
        do_POST = forward

    server = ThreadingHTTPServer(("127.0.0.1", 0), Proxy)
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()
    env = dict(os.environ, GOOGLE_GEMINI_BASE_URL=f"http://127.0.0.1:{server.server_port}",
               GEMINI_API_KEY=os.environ.get("MODEL_ROUTER_API_KEY", "unused"))
    args = sys.argv[1:]
    if not any(arg == "--model" or arg.startswith("--model=") for arg in args):
        settings = json.loads((Path.home() / ".gemini/antigravity-cli/settings.json").read_text())
        args = ["--model", settings.get("model", "deepseek-v4.1-flash"), *args]
    try:
        return subprocess.call([str(Path.home() / ".local/libexec/antigravity/agy"), *args], env=env)
    finally:
        server.shutdown()
        server.server_close()


if __name__ == "__main__":
    sys.exit(main())
