{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "spaces session-hook codex start >/dev/null 2>&1 || true",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "spaces session-hook codex stop >/dev/null 2>&1 || true",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "spaces session-hook codex prompt >/dev/null 2>&1 || true",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "spaces hook codex PreToolUse >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "spaces hook codex PostToolUse >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "spaces hook codex PermissionRequest >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "spaces hook codex SubagentStart >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "spaces hook codex SubagentStop >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "spaces hook codex Interrupt >/dev/null 2>&1 || true",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ]
  }
}
