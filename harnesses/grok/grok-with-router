#!/bin/sh
set -eu

. "${XDG_CONFIG_HOME:-$HOME/.config}/ai/model-router.env"

# Isolate router config, credentials, model cache, sessions, and leader socket.
export GROK_HOME="$HOME/.grok-t3/model-router"
export GROK_MODELS_BASE_URL="${MODEL_ROUTER_URL%/}/v1"
export GROK_MODELS_LIST_URL="$GROK_MODELS_BASE_URL/models"
export XAI_API_KEY="$MODEL_ROUTER_API_KEY"
# The router needs an affinity key for upstream providers such as OpenCode Go.
export GROK_MODEL_ROUTER_SESSION="router-session-$(python3 -c 'from uuid import uuid4; print(uuid4())')"

exec "$HOME/.local/bin/grok" "$@"
