#!/usr/bin/env python3
"""Launch a named configuration using the agent's own terminal interface."""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys

HOME = Path.home()
STATE = HOME / '.config/ai/orca'
ROOT = Path(__file__).resolve().parent
HARNESS = HOME / '.local/bin/harness'
NATIVE_SETTINGS = STATE / 'antigravity-native-settings.json'
TERMINALS = {
    'claudeAgent': ('claude', []),
    'codex_router': ('codex', []),
    'grok_router': ('grok', []),
    'muse': ('muse', []),
    'fx': ('fx', []),
    'opencode': ('opencode', []),
    'pi': ('pi', []),
    'acpRegistry_qwen': ('qwen', []),
    'acpRegistry_copilot': ('copilot', []),
    'acpRegistry_kimi': ('kimi', []),
    'acpRegistry_kimi_legacy': ('kimi-cli', []),
    'acpRegistry_cline': ('cline', ['--tui']),
    'acpRegistry_kilo': ('kilo', []),
    'acpRegistry_mistral_vibe': ('vibe', []),
    'acpRegistry_gemini': ('gemini', []),
    'acpRegistry_antigravity_router': ('antigravity', []),
}


def providers():
    settings = json.loads((HOME / '.t3/userdata/settings.json').read_text())
    return {'codex': {'driver': 'codex', 'enabled': True, 'displayName': 'Codex'},
            **settings['providerInstances']}


def launch_plan(instance):
    provider = providers()[instance]
    if not provider.get('enabled', True):
        raise RuntimeError(f'{instance} is disabled')
    env = os.environ.copy()
    env.pop('HARNESS_AGENT', None)
    if instance == 'codex_router':
        shadow = provider.get('config', {}).get('shadowHomePath')
        if shadow:
            env['CODEX_HOME'] = shadow
    env['PATH'] = os.pathsep.join([
        str(HOME / '.local/share/fnm'),
        str(HOME / '.local/share/fnm/aliases/default/bin'),
        str(HOME / '.local/share/deepseek-harness/bin'),
        str(HOME / '.local/share/pnpm/bin'), env.get('PATH', '')])
    if instance in ('antigravity', 'antigravity_mahajanarham'):
        for key in ('GEMINI_API_KEY', 'GOOGLE_API_KEY', 'GOOGLE_GEMINI_BASE_URL'):
            env.pop(key, None)
        command = [str(HOME / '.local/libexec/antigravity/agy'),
                   '--settings', str(NATIVE_SETTINGS)]
    elif instance == 'acpRegistry_mcode':
        command = [str(HOME / '.minimax-code/bin/mcode')]
    elif instance == 'acpRegistry_omp':
        command = [str(HOME / '.local/bin/omp')]
    elif instance == 'acpRegistry_dsh':
        command = [str(HARNESS), 'deepseek', '--profile', 'dsh-tui',
                   '--patch', str(STATE / 'dsh-terminal.patch.yml')]
        env.setdefault('MODEL_ROUTER_API_KEY', 'unused')
    elif instance in TERMINALS:
        selector, args = TERMINALS[instance]
        command = [str(HARNESS), selector, *args]
        if instance == 'acpRegistry_cline':
            env.update({e['name']: e['value'] for e in provider.get('environment', [])
                        if e['name'] not in ('PATH', 'HARNESS_AGENT', 'CLINE_API_KEY')})
    else:
        driver = provider['driver']
        command = [shutil.which(driver) or driver]
    return command, env


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--list', action='store_true')
    parser.add_argument('--describe', action='store_true')
    parser.add_argument('instance', nargs='?')
    args, extra = parser.parse_known_args()
    if args.list:
        for key, provider in providers().items():
            if provider.get('enabled', True):
                print(f"{key}\t{provider.get('displayName') or key}")
        return
    if not args.instance:
        parser.error('Choose an instance from --list')
    command, env = launch_plan(args.instance)
    command += extra
    if args.describe:
        print(shlex.join(command))
        return
    if args.instance in ('antigravity', 'antigravity_mahajanarham'):
        accounts = json.loads((STATE / 'antigravity-native-accounts.json').read_text())
        subprocess.run(['node', str(ROOT / 'rpc.cjs'), 'accounts.antigravitySelect',
                        json.dumps({'target': {'runtime': 'host'},
                                    'accountId': accounts[args.instance]})],
                       check=True, stdout=subprocess.DEVNULL)
    os.execvpe(command[0], command, env)


if __name__ == '__main__':
    try:
        main()
    except (KeyError, OSError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f'orca-agent: {error}')
