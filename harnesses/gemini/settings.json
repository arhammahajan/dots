  "mcp": {
    "excluded": [
      "agent-browser",
      "playwright",
      "browser-use"
    ]
  },
  "mcpServers": {
    "cua-driver": {
      "command": "${HOME}/.local/bin/cua-driver",
      "args": [
        "mcp"
      ]
    },
    "agent-browser": {
      "command": "${HOME}/.local/bin/agent-browser",
      "args": [
        "mcp",
        "--tools",
        "core,debug",
        "--config",
        "${HOME}/.local/share/helium-tools/agent-browser/config.json"
      ]
    },
    "playwright": {
      "command": "node",
      "args": [
        "${HOME}/.local/share/playwright-mcp/attach-helium.mjs"
      ]
    },
    "browser-use": {
      "command": "${HOME}/.local/bin/browser-use-helium",
      "args": [
        "--mcp"
      ]
    }
  },
